# real-guard-v1 environment configuration — SPEC.md §15.
# Copy to .env and edit. CFG-004: .env itself must never be committed
# (.gitignore already excludes it) and this file must never hold a real secret.

# --- Core ---------------------------------------------------------------
APP_ENV=development
BIND_HOST=127.0.0.1
BIND_PORT=8000

# --- Authentication (SEC-001..004) --------------------------------------
# Empty is allowed only in development on a loopback bind. Required (each
# entry >=32 chars, and the two lists must be disjoint) when APP_ENV=production.
FIREWALL_API_KEYS=
FIREWALL_REVIEWER_KEYS=
# SESSION_SECRET is auto-generated (ephemeral) in development if left unset.
# Production requires a persistent value >=32 bytes — set one explicitly.
SESSION_SECRET=

# --- Upstream provider (SPEC.md §2.8-2.10, §14) -------------------------
# Leave UPSTREAM_BASE_URL unset to run in deterministic mock mode (the
# default — see PLAN.md D1/canonical decisions). Point it at Ollama for the
# qwen3:8b reference path, or any OpenAI-compatible endpoint.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=qwen3:8b
# Ollama-host profile example (docker-compose --profile ollama-host):
#   UPSTREAM_BASE_URL=http://host.docker.internal:11434/v1
# Generic OpenAI-compatible example:
#   UPSTREAM_BASE_URL=https://api.openai.com/v1
#   UPSTREAM_API_KEY=sk-...
#   UPSTREAM_MODEL=gpt-4o-mini

# --- Policy and storage ---------------------------------------------------
POLICY_PATH=policies/default_policy.yaml
DATABASE_URL=sqlite:///./data/realguard.db
CONTENT_RETENTION=metadata
CONTENT_ENCRYPTION_KEY=

# --- Logging / limits (SPEC.md §15) -------------------------------------
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=60.0
MAX_REQUEST_BYTES=262144
APPROVAL_TTL_SECONDS=3600
DETECTOR_TIMEOUT_MS=250
MAX_DECODE_DEPTH=3
MAX_RESUME_ATTEMPTS=3
SESSION_TTL_SECONDS=3600
IDEMPOTENCY_TTL_SECONDS=86400
AUDIT_RETENTION_DAYS=90
CONTENT_RETENTION_DAYS=7
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
METRICS_REQUIRE_AUTH=false

# --- Secrets with no safe default (CFG-003: never logged) ----------------
HASH_SALT=

# --- Escape hatches — leave false; production refuses them without an
# explicit, loud override (DEP-005, PRV-002) ------------------------------
ALLOW_MOCK_IN_PRODUCTION=false
ALLOW_PLAINTEXT_RETENTION=false

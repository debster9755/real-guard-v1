          "decision": {
            "enum": [
              "APPROVE",
              "DENY"
            ],
            "title": "Decision",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "reviewer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Id"
          }
        },
        "required": [
          "decision"
        ],
        "title": "ApprovalDecisionRequest",
        "type": "object"
      },
      "ApprovalListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ApprovalPreview"
            },

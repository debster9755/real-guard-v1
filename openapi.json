          }
        },
        "required": [
          "items"
        ],
        "title": "ApprovalListResponse",
        "type": "object"
      },
      "ApprovalPreview": {
        "description": "API-010, APR-012: `preview` carries transformed content only.",
        "properties": {
          "approval_id": {
            "title": "Approval Id",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "title": "Expires At",
            "type": "string"
          },
          "policy_hits": {
            "items": {
              "type": "string"
            },
            "title": "Policy Hits",
            "type": "array"
          },
          "preview": {
            "additionalProperties": true,
            "title": "Preview",
            "type": "object"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "risk_level": {
            "enum": [
              "NONE",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ],
            "title": "Risk Level",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "transaction_id": {
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "approval_id",
          "transaction_id",
          "status",
          "risk_level",
          "reason_codes",
          "policy_hits",
          "preview",
          "created_at",
          "expires_at"
        ],
        "title": "ApprovalPreview",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthzResponse": {

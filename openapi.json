{
  "components": {
    "schemas": {
      "ApprovalDecisionRequest": {
        "description": "SPEC.md \u00a74.6. API-012: `note` is required (non-empty) when\n`decision` is DENY \u2014 enforced in app/approvals.py, not here, since the\nrule is conditional on the field's own value.",

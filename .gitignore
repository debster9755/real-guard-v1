# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
/build/

# Environment / secrets — CFG-004: .env must never be tracked
.env
!.env.example

# Local data (DAT-*: SQLite database, WAL/SHM files) — /data only, never tests/data
/data/
*.db
*.db-shm
*.db-wal

# Node / /console SPA build artefacts (ADR 0014). Also covered by
# web/.gitignore; repeated here so a `git status` from the repository root
# is clean even if that file is ever removed. node_modules is never
# committed — the Dockerfile's web-builder stage runs `npm ci` from the
# committed web/package-lock.json instead.
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
*.tsbuildinfo

# OS
.DS_Store

# Editors
.vscode/
.idea/
